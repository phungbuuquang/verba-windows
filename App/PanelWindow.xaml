<Window x:Class="verba_windows.AppHost.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:verba_windows.Views"
        Title="verba" Icon="/Assets/AppIcon.ico" Width="640" SizeToContent="Height" MaxHeight="760"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        PreviewKeyDown="Window_PreviewKeyDown" Deactivated="Window_Deactivated"
        SourceInitialized="Window_SourceInitialized">
    <Window.Resources>
        <views:InverseBooleanConverter x:Key="InverseBool" />
        <views:LanguageNameConverter x:Key="LanguageName" />
        <views:CustomToneSelectedConverter x:Key="CustomToneSelected" />
        <views:EmptyStringVisibilityConverter x:Key="EmptyStringVisibility" />

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Padding" Value="7,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Opacity" Value="0.78"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Padding" Value="11,5"/><Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ChipBorderBrush}"/><Setter Property="BorderThickness" Value="0.5"/>
        </Style>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="AcceptsReturn" Value="True"/>
        </Style>
        <DataTemplate x:Key="LanguageTemplate">
            <TextBlock>
                <TextBlock.Text><MultiBinding Converter="{StaticResource LanguageName}">
                    <Binding/><Binding Path="DataContext.LanguageStore.Current" RelativeSource="{RelativeSource AncestorType=Window}"/>
                </MultiBinding></TextBlock.Text>
            </TextBlock>
        </DataTemplate>
    </Window.Resources>

    <Border Margin="12" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="0.5" CornerRadius="12" MouseLeftButtonDown="Panel_MouseLeftButtonDown">
        <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.28"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="0.5"/><RowDefinition Height="260"/>
                <RowDefinition Height="0.5"/><RowDefinition Height="Auto"/><RowDefinition Height="0.5"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="0.5"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="12,9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Click="Auto_Click" IsEnabled="{Binding IsTranslating, Converter={StaticResource InverseBool}}" ToolTip="{Binding AutoDetectTooltip}">
                    <TextBlock Text="{Binding Strings.AutoDetect}"/>
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                        <Setter Property="Background" Value="{DynamicResource PillBrush}"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsAutoDetectSource}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers>
                    </Style></Button.Style>
                </Button>
                <ComboBox x:Name="SourceLanguageBox" Grid.Column="1" Margin="6,0" ItemsSource="{Binding Languages}" SelectedValuePath="Id" SelectedValue="{Binding SourceLanguage.Id, Mode=OneWay}" ItemTemplate="{StaticResource LanguageTemplate}"
                          SelectionChanged="SourceLanguage_SelectionChanged" IsEnabled="{Binding IsTranslating, Converter={StaticResource InverseBool}}">
                    <ComboBox.Style><Style TargetType="ComboBox"><Style.Triggers><DataTrigger Binding="{Binding IsAutoDetectSource}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ComboBox.Style>
                </ComboBox>
                <Button Grid.Column="2" Content="⇄" Style="{StaticResource FlatButton}" Click="Swap_Click" IsEnabled="{Binding CanSwapNow}" ToolTip="{Binding SwapTooltip}"/>
                <ComboBox x:Name="TargetLanguageBox" Grid.Column="3" Margin="6,0" ItemsSource="{Binding Languages}" SelectedValuePath="Id" SelectedValue="{Binding TargetLanguage.Id, Mode=OneWay}" ItemTemplate="{StaticResource LanguageTemplate}"
                          SelectionChanged="TargetLanguage_SelectionChanged" IsEnabled="{Binding IsTranslating, Converter={StaticResource InverseBool}}"/>
                <TextBlock Grid.Column="5" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="8,0" Text="{Binding TrialText}"/>
                <Button Grid.Column="6" Content="⚙" Style="{StaticResource FlatButton}" Click="Gear_Click"/>
                <Popup x:Name="GearPopup" Grid.Column="6" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Closed="GearPopup_Closed">
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource ChipBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="6">
                        <StackPanel MinWidth="240">
                            <TextBlock Text="{Binding Strings.AppLanguage}" FontWeight="SemiBold" Margin="7,4"/>
                            <Button x:Name="EnglishLanguageButton" Content="English" Tag="en" Click="Language_Click" Style="{StaticResource FlatButton}" HorizontalContentAlignment="Left"/>
                            <Button x:Name="VietnameseLanguageButton" Content="Tiếng Việt" Tag="vi" Click="Language_Click" Style="{StaticResource FlatButton}" HorizontalContentAlignment="Left"/>
                            <Button x:Name="KoreanLanguageButton" Content="한국어" Tag="ko" Click="Language_Click" Style="{StaticResource FlatButton}" HorizontalContentAlignment="Left"/>
                            <Separator Margin="0,5"/>
                            <TextBlock Text="{Binding Strings.GlobalShortcut}" FontWeight="SemiBold" Margin="7,4"/>
                            <Grid Margin="7,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="ShortcutBox" Grid.Column="0" IsReadOnly="True" Padding="7,5" Cursor="Hand"
                                         PreviewKeyDown="Shortcut_PreviewKeyDown" GotKeyboardFocus="Shortcut_GotKeyboardFocus"/>
                                <Button Grid.Column="1" Content="{Binding Strings.ResetShortcut}" Click="ResetShortcut_Click"
                                        Style="{StaticResource FlatButton}" Margin="5,0,0,0"/>
                            </Grid>
                            <TextBlock Text="{Binding Strings.ShortcutHint}" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="7,2"/>
                            <TextBlock x:Name="ShortcutStatus" Foreground="#E5484D" FontSize="11" TextWrapping="Wrap" Margin="7,2"/>
                            <Separator Margin="0,5"/><Button Content="{Binding Strings.Quit}" Click="Quit_Click" Style="{StaticResource FlatButton}" HorizontalContentAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
            <Rectangle Grid.Row="1" Fill="{DynamicResource HairlineBrush}"/>

            <!-- Source and result -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="0.5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="14,12">
                    <TextBox x:Name="SourceBox" Style="{StaticResource InputBox}" FontSize="14" Text="{Binding SourceText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalScrollBarVisibility="Auto" PreviewKeyDown="Editor_PreviewKeyDown" Tag="source" Padding="0,0,26,26"/>
                    <TextBlock Text="{Binding Strings.SourcePlaceholder}" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" TextWrapping="Wrap" Margin="2">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                            <DataTrigger Binding="{Binding SourceText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <Button Content="×" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Clear_Click" ToolTip="{Binding Strings.ClearAll}">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource FlatButton}"><Style.Triggers><DataTrigger Binding="{Binding SourceText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                    <Button Content="{Binding SourceSpeechIcon}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Click="SourceSpeech_Click" IsEnabled="{Binding CanSpeakSource}" ToolTip="{Binding SourceSpeechTooltip}"
                            ToolTipService.ShowOnDisabled="True">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource FlatButton}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers>
                            <DataTrigger Binding="{Binding SourceText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers></Style></Button.Style>
                    </Button>
                </Grid>
                <Rectangle Grid.Column="1" Fill="{DynamicResource HairlineBrush}"/>
                <Grid Grid.Column="2" Margin="16,12">
                    <TextBox FontSize="17" TextBlock.LineHeight="25" TextBlock.LineStackingStrategy="BlockLineHeight" IsReadOnly="True" Text="{Binding TranslatedText, Mode=OneWay}" VerticalScrollBarVisibility="Auto" Padding="0,0,28,26">
                        <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource InputBox}"><Style.Triggers><DataTrigger Binding="{Binding IsTranslating}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBox.Style>
                    </TextBox>
                    <TextBlock Text="…" Foreground="{DynamicResource MutedBrush}" FontSize="17" IsHitTestVisible="False">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                            <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding TranslatedText}" Value=""/><Condition Binding="{Binding IsTranslating}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
                        </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsTranslating}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="4" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform ScaleX="0.7" ScaleY="0.7"/></Ellipse.RenderTransform><Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever" AutoReverse="True"><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.5"/><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.7" To="1" Duration="0:0:0.5"/><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.7" To="1" Duration="0:0:0.5"/></Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers></Ellipse>
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="4" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform ScaleX="0.7" ScaleY="0.7"/></Ellipse.RenderTransform><Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever" AutoReverse="True" BeginTime="0:0:0.18"><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.5"/><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.7" To="1" Duration="0:0:0.5"/><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.7" To="1" Duration="0:0:0.5"/></Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers></Ellipse>
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="4" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform ScaleX="0.7" ScaleY="0.7"/></Ellipse.RenderTransform><Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever" AutoReverse="True" BeginTime="0:0:0.36"><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.5"/><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.7" To="1" Duration="0:0:0.5"/><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.7" To="1" Duration="0:0:0.5"/></Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers></Ellipse>
                    </StackPanel>
                    <Button Content="{Binding ResultSpeechIcon}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Click="ResultSpeech_Click" IsEnabled="{Binding CanSpeakResult}" ToolTip="{Binding ResultSpeechTooltip}"
                            ToolTipService.ShowOnDisabled="True">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource FlatButton}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers>
                            <DataTrigger Binding="{Binding TranslatedText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsTranslating}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers></Style></Button.Style>
                    </Button>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#E5484D" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Bottom"/>
                </Grid>
            </Grid>
            <Rectangle Grid.Row="3" Fill="{DynamicResource HairlineBrush}"/>

            <!-- Refinement rows -->
            <StackPanel Grid.Row="4" Margin="14,10,14,5">
                <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsEmptyState}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <WrapPanel>
                    <Button Content="{Binding Strings.ToneCasual}" Click="Casual_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ChipButton}"><Style.Triggers><DataTrigger Binding="{Binding IsCasual}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="0"/></DataTrigger><DataTrigger Binding="{Binding IsTranslating}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                    <Button Content="{Binding Strings.ToneNeutral}" Click="Neutral_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ChipButton}"><Style.Triggers><DataTrigger Binding="{Binding IsNeutral}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger><DataTrigger Binding="{Binding IsTranslating}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                    <Button Content="{Binding Strings.ToneFormal}" Click="Formal_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ChipButton}"><Style.Triggers><DataTrigger Binding="{Binding IsFormal}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger><DataTrigger Binding="{Binding IsTranslating}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                    <ItemsControl ItemsSource="{Binding CustomTones}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                        <Button Content="{Binding Title}" ToolTip="{Binding Instruction}" Click="CustomTone_Click" ContextMenuOpening="CustomTone_ContextMenuOpening">
                            <Button.ContextMenu><ContextMenu><MenuItem Header="Edit" Click="EditTone_Click"/><MenuItem Header="Delete" Click="DeleteTone_Click"/></ContextMenu></Button.ContextMenu>
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ChipButton}"><Style.Triggers>
                                <DataTrigger Value="True"><DataTrigger.Binding><MultiBinding Converter="{StaticResource CustomToneSelected}"><Binding/><Binding Path="DataContext.Tone" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></DataTrigger.Binding><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger>
                                <DataTrigger Binding="{Binding DataContext.IsTranslating, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                            </Style.Triggers></Style></Button.Style>
                        </Button>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <Button Content="+" Style="{StaticResource ChipButton}" Click="AddTone_Click" ToolTip="{Binding Strings.AddCustomToneHelp}"/>
                </WrapPanel>
                <Border x:Name="ToneEditor" Visibility="Collapsed" Background="{DynamicResource PillBrush}" CornerRadius="7" Padding="8" Margin="0,2,0,8">
                    <DockPanel><Button DockPanel.Dock="Right" Content="{Binding Strings.CancelCustomTone}" Style="{StaticResource FlatButton}" Click="CancelTone_Click"/>
                        <Button x:Name="SaveToneButton" DockPanel.Dock="Right" Content="{Binding Strings.SaveCustomTone}" Style="{StaticResource FlatButton}" Click="SaveTone_Click" IsEnabled="False"/>
                        <Grid>
                            <TextBox x:Name="ToneDraftBox" Style="{StaticResource InputBox}" MinHeight="28" TextChanged="ToneDraft_TextChanged" PreviewKeyDown="Editor_PreviewKeyDown" Tag="tone"/>
                            <TextBlock Text="{Binding Strings.CustomTonePlaceholder}" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" Margin="2,5">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ToneDraftBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                </Border>
                <WrapPanel>
                    <Button Content="{Binding Strings.ActionShorter}" Click="Shorter_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ChipButton}"><Style.Triggers><DataTrigger Binding="{Binding IsShorter}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/></DataTrigger><DataTrigger Binding="{Binding IsTranslating}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                    <Button Content="{Binding Strings.ActionNatural}" Click="Natural_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ChipButton}"><Style.Triggers><DataTrigger Binding="{Binding IsNatural}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/></DataTrigger><DataTrigger Binding="{Binding IsTranslating}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                    <Button Content="{Binding Strings.ActionKeepTerms}" Click="KeepTerms_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ChipButton}"><Style.Triggers><DataTrigger Binding="{Binding IsKeepTerms}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/></DataTrigger><DataTrigger Binding="{Binding IsTranslating}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                    <Button Content="{Binding Strings.ActionExplain}" Click="Explain_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ChipButton}"><Style.Triggers><DataTrigger Binding="{Binding IsExplain}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/></DataTrigger><DataTrigger Binding="{Binding IsTranslating}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                </WrapPanel>
            </StackPanel>
            <Rectangle Grid.Row="5" Fill="{DynamicResource HairlineBrush}"/>
            <Grid Grid.Row="6" Margin="14,8">
                <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsEmptyState}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="↳" FontSize="18" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBox x:Name="FreeformBox" Grid.Column="1" Style="{StaticResource InputBox}" MinHeight="28" MaxHeight="70" Margin="8,0" Text="{Binding Freeform, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="Editor_PreviewKeyDown" Tag="freeform"/>
                <TextBlock Grid.Column="1" Text="{Binding Strings.FreeformPlaceholder}" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" Margin="10,5">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Freeform}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <Button Grid.Column="2" Content="↑" Style="{StaticResource FlatButton}" Click="Freeform_Click" IsEnabled="{Binding CanApplyFreeform}"/>
            </Grid>
            <Rectangle Grid.Row="7" Fill="{DynamicResource HairlineBrush}"/>
            <Grid Grid.Row="8" Background="{DynamicResource FooterBrush}" Margin="0,0,0,0">
                <StackPanel Orientation="Horizontal" Margin="12,8">
                    <Button Content="↶" Style="{StaticResource FlatButton}" Click="Undo_Click" IsEnabled="{Binding CanUndo}" ToolTip="{Binding Strings.Undo}"/>
                    <Button Content="↷" Style="{StaticResource FlatButton}" Click="Redo_Click" IsEnabled="{Binding CanRedo}" ToolTip="{Binding Strings.Redo}"/>
                    <TextBlock Text="🕘" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,8">
                    <TextBlock Text="Ctrl⏎" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="CopyButton" Content="{Binding Strings.CopyAndClose}" Click="Copy_Click" IsEnabled="{Binding CanCopy}" Foreground="White" Background="{DynamicResource AccentBrush}" Style="{StaticResource FlatButton}" Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
